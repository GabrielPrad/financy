# Segredo usado para assinar os tokens JWT (troque por um valor aleatório e secreto)
JWT_SECRET=

# String de conexão do banco de dados (SQLite)
DATABASE_URL="file:./dev.db"

# --- Variáveis opcionais (possuem valor padrão) ---

# Porta em que a API sobe (padrão: 4000)
PORT=4000

# Tempo de expiração do token JWT (padrão: 7d)
JWT_EXPIRES_IN=7d

# Origens liberadas no CORS, separadas por vírgula. Use * para liberar todas.
CORS_ORIGIN=http://localhost:5173
