generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories   Category[]
  transactions Transaction[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#8B5CF6")
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  // Uma categoria pertence a um único usuário e o nome não se repete para ele
  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id          String   @id @default(uuid())
  description String
  /// Valor armazenado em centavos para evitar imprecisão de ponto flutuante
  amountCents Int
  /// INCOME (entrada) ou EXPENSE (saída) — SQLite não suporta enums nativos
  type        String
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([categoryId])
  @@index([userId, date])
  @@map("transactions")
}
